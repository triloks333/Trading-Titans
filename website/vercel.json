{
  "rewrites": [
    {
      "source": "/app",
      "destination": "https://trading-titans-web.vercel.app/app"
    },
    {
      "source": "/app/:path*",
      "destination": "https://trading-titans-web.vercel.app/app/:path*"
    },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/blog", "destination": "/api/blog" },
    { "source": "/blog/:slug", "destination": "/api/post?slug=:slug" },
    { "source": "/topup", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
